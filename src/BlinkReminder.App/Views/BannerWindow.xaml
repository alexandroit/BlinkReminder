<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BlinkReminder.App.Views.BannerWindow" Style="{StaticResource {x:Type Window}}" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False" IsHitTestVisible="False" SizeToContent="Height" Width="440">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="10" Padding="22,16">
    <StackPanel>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock x:Name="CountdownText" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
    </StackPanel>
  </Border>
</Window>
